                    "errorType": { "label": "Error type", "format": "text" },
                    "error": { "label": "Error", "format": "text" }
                }
            }
        },
        "labMetrics": {
            "title": "Lab metrics",
            "transformation": {
                "fields": ["url", "strategy", "labMetrics", "lighthouseVersion", "analysisTimestamp"]
            },
