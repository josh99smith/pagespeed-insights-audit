{
    "built-in-key": {
        "input": {
            "urls": [
                "https://example.com"
            ]
        },
        "expect": {
            "status": "SUCCEEDED",
            "minOk": 1,
            "maxFailed": 0
        }
    },
    "bad-key": {
        "input": {
            "urls": [
                "https://example.com"
            ],
            "apiKey": "invalid-key-for-testing"
        },
        "expect": {
            "status": "SUCCEEDED",
            "maxOk": 0,
            "errorTypes": [
                "other",
                "http-error",
                "rate-limited"
            ]
        }
    },
    "empty-input": {
        "input": {
            "urls": []
        },
        "expect": {
            "status": "FAILED",
            "maxItems": 0
        }
    }
}